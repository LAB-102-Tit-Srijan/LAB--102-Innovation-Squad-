rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() { return request.auth != null; }
    function isOwner(userId) { return isSignedIn() && request.auth.uid == userId; }
    function isValidId(id) { return id is string && id.size() <= 128; }
    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // User Rules
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create: if isOwner(userId) && incoming().keys().hasAll(['uid', 'name', 'email', 'role']) 
                    && incoming().role in ['traveler', 'host'];
      allow update: if isOwner(userId) && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'trustScore', 'lastLocation', 'updatedAt', 'premiumMember', 'governmentIdVerified', 'faceIdVerified']);
    }

    // Group Rules
    match /groups/{groupId} {
      allow read: if isSignedIn() && request.auth.uid in existing().members;
      allow create: if isSignedIn() && (incoming().adminId == request.auth.uid || request.auth.uid in incoming().members);
      allow update, delete: if isSignedIn() && request.auth.uid in existing().members;
      
      // Expenses subcollection
      match /expenses/{expenseId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow create: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
        allow update, delete: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/groups/$(groupId)).data.members;
      }
    }

    // Listings/Stays Rules
    match /listings/{listingId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().hostId == request.auth.uid;
      allow update: if isSignedIn() && existing().hostId == request.auth.uid 
                    && !incoming().diff(existing()).affectedKeys().hasAny(['isVerified', 'status']);
      allow delete: if isSignedIn() && existing().hostId == request.auth.uid;

      // Sensitive fields logic (conceptual since Firestore rules don't support field-level read masks easily)
      // We will handle this by not returning these fields in general queries or using a subcollection.
    }

    match /stays/{stayId} {
      allow read: if true;
      allow write: if isSignedIn();
    }

    // Itinerary Rules
    match /itineraries/{itId} {
      allow read: if isOwner(existing().userId);
      allow create: if isOwner(incoming().userId);
    }

    // Guide Rules
    match /guides/{guideId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid;
    }
  }
}
