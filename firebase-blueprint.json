{
  "entities": {
    "User": {
      "title": "User Profile",
      "description": "Represents a traveler or host in the Ghoomo ecosystem.",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "role": { "type": "string", "enum": ["traveler", "host", "admin"] },
        "isVerified": { "type": "boolean" },
        "trustScore": { "type": "number" },
        "premiumMember": { "type": "boolean" },
        "governmentIdVerified": { "type": "boolean" },
        "faceIdVerified": { "type": "boolean" },
        "lastLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "name", "email", "role"]
    },
    "Stay": {
      "title": "Accommodation Listing",
      "description": "A property listed for rent by a host.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "hostId": { "type": "string" },
        "name": { "type": "string" },
        "type": { "type": "string", "enum": ["PG", "Hotel", "Hostel", "Emergency Home Stay"] },
        "city": { "type": "string" },
        "location": { "type": "string" },
        "gps": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" }
          }
        },
        "price_range": { "type": "string" },
        "description": { "type": "string" },
        "images": { "type": "array", "items": { "type": "string" } },
        "isVerified": { "type": "boolean" },
        "status": { "type": "string", "enum": ["pending", "verified", "rejected"] },
        "governmentIdUrl": { "type": "string" },
        "propertyDocsUrl": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["hostId", "name", "type", "city", "location", "price_range"]
    },
    "Rental": {
      "title": "Vehicle Rental",
      "description": "Vehicle available for hourly rental.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "ownerId": { "type": "string" },
        "type": { "type": "string", "enum": ["Scooter", "Bike", "Car"] },
        "hourlyRate": { "type": "number" },
        "images": { "type": "array", "items": { "type": "string" } },
        "status": { "type": "string", "enum": ["available", "rented"] }
      },
      "required": ["ownerId", "type", "hourlyRate"]
    },
    "Group": {
      "title": "Travel Group",
      "description": "A group of travelers splitting bills and sharing experiences.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "destination": { "type": "string" },
        "adminId": { "type": "string" },
        "members": { "type": "array", "items": { "type": "string" } },
        "inviteCode": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["name", "adminId", "members"]
    },
    "Expense": {
      "title": "Trip Expense",
      "description": "An expense record within a group.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "groupId": { "type": "string" },
        "paidById": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string", "enum": ["Hotel", "Food", "Fuel", "Guide", "Shopping", "Transport", "Emergency"] },
        "splitType": { "type": "string", "enum": ["equal", "percentage", "custom"] },
        "splitDetails": { "type": "object" },
        "timestamp": { "type": "string", "format": "date-time" }
      },
      "required": ["groupId", "paidById", "amount", "splitType"]
    },
    "Itinerary": {
      "title": "AI Travel Itinerary",
      "description": "Personalized travel plan generated by AI.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "destination": { "type": "string" },
        "budget": { "type": "string" },
        "category": { "type": "string" },
        "startDate": { "type": "string" },
        "days": { "type": "number" },
        "plan": { "type": "array", "items": { "type": "object" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "destination", "plan"]
    },
    "Guide": {
      "title": "Local Guide",
      "description": "A verified local individual offering guiding services.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "bio": { "type": "string" },
        "experience": { "type": "string" },
        "hourlyRate": { "type": "number" },
        "dailyRate": { "type": "number" },
        "languages": { "type": "array", "items": { "type": "string" } },
        "baseLocation": {
          "type": "object",
          "properties": {
            "lat": { "type": "number" },
            "lng": { "type": "number" },
            "cityName": { "type": "string" }
          }
        },
        "rating": { "type": "number" },
        "isVerified": { "type": "boolean" },
        "governmentIdUrl": { "type": "string" },
        "certificationUrl": { "type": "string" },
        "phoneNumber": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "bio", "hourlyRate", "languages", "phoneNumber"]
    }
  },
  "firestore": {
    "users": { "schema": "User", "description": "User profiles and verification data." },
    "listings": { "schema": "Stay", "description": "Consolidated accommodation and experience listings." },
    "rentals": { "schema": "Rental", "description": "Vehicle rental listings." },
    "groups": { "schema": "Group", "description": "Travel groups for split bills." },
    "groups/{groupId}/expenses": { "schema": "Expense", "description": "Expenses for a specific group." },
    "itineraries": { "schema": "Itinerary", "description": "AI generated travel plans." },
    "guides": { "schema": "Guide", "description": "Local guide profiles." }
  }
}
